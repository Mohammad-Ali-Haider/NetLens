# Single-user deployment. Replace before allowing access from other hosts.
NETLENS_API_KEY=change-me-local-only
NETLENS_DATABASE_URL=postgresql+psycopg://netlens:netlens-local@127.0.0.1:5432/netlens
NETLENS_REDIS_URL=redis://127.0.0.1:6379/0
NETLENS_STORAGE_DIR=./data/captures
NETLENS_QUEUE_MODE=rq
NETLENS_MAX_UPLOAD_BYTES=20971520
NETLENS_MAX_PACKETS=100000
NETLENS_MAX_PARSE_SECONDS=30
NETLENS_DNS_SLOW_MS=250
NETLENS_RETENTION_DAYS=7
NETLENS_PROVIDER_TIMEOUT_SECONDS=30
NETLENS_PROVIDER_RETRIES=2
NETLENS_OUTPUT_TOKENS=1800
# No fallback unless explicitly configured:
# NETLENS_FALLBACK_PROVIDER=mock
# NETLENS_OPENAI_API_KEY=
NETLENS_OPENAI_MODEL=gpt-4.1-mini
# NETLENS_ANTHROPIC_API_KEY=
NETLENS_ANTHROPIC_MODEL=claude-sonnet-4-6
NETLENS_OLLAMA_URL=http://localhost:11434
NETLENS_OLLAMA_MODEL=llama3.2

# Compose host ports (change if another service already uses these):
NETLENS_API_PORT=8000
NETLENS_DB_PORT=5432
NETLENS_REDIS_PORT=6379
